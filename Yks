            background: rgba(17, 24, 39, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .grid-tile {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
